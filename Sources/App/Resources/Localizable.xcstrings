{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NewPal for macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新仙剑奇侠传 macOS 版启动器"
          }
        }
      }
    },
    "menu.whats_new": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's New in NewPal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NewPal 新功能介绍"
          }
        }
      }
    },
    "badge.sdl3_metal_ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL3 Backend: Metal Active"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL3 后端：Metal 已就绪"
          }
        }
      }
    },
    "badge.sdl3_metal_missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL3 Metal Backend Unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL3 Metal 后端不可用"
          }
        }
      }
    },
    "byod.card_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original Game Data Directory (BYOD)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原版游戏数据目录（自备正版资产）"
          }
        }
      }
    },
    "byod.legal_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No copyrighted sprites, audio, scripts, or maps are bundled. Click Import Game Data to select your original game folder; the launcher verifies all 23 archives and copies only the required game files into ~/Library/Application Support/NewPal/PalGame. Afterward, you may freely delete the original folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不含任何受版权保护的美术、音频、脚本或地图资源。点击「导入数据包…」选择原版游戏文件夹后，启动器将主动校验全部 23 项核心文件并自动将所需数据复制到 ~/Library/Application Support/NewPal/PalGame；导入完成后原游戏文件夹可自由删除。"
          }
        }
      }
    },
    "byod.no_folder_selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No game data imported yet. Click Import Game Data… to begin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未导入游戏数据包，请点击「导入数据包…」选择原版游戏目录。"
          }
        }
      }
    },
    "byod.imported_ready_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported into standard Application Support directory. You may safely delete your original game folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入至 macOS 标准目录，原游戏文件夹可自由删除。"
          }
        }
      }
    },
    "byod.import_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Game Data…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入数据包…"
          }
        }
      }
    },
    "byod.reimport_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-Import Data…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新导入数据包…"
          }
        }
      }
    },
    "byod.open_app_support": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Application Support"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Application Support"
          }
        }
      }
    },
    "byod.data_dir_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏数据"
          }
        }
      }
    },
    "byod.save_dir_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏存档"
          }
        }
      }
    },
    "byod.open_data_folder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Data Folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开数据目录"
          }
        }
      }
    },
    "byod.open_save_folder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Save Folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开存档目录"
          }
        }
      }
    },
    "byod.save_count_fmt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld save(s)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 %lld 个存档"
          }
        }
      }
    },
    "byod.save_count_empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saves yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无存档"
          }
        }
      }
    },
    "byod.delete_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Game Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除游戏数据"
          }
        }
      }
    },
    "byod.delete_confirm_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Imported Game Data?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认删除已导入的游戏数据？"
          }
        }
      }
    },
    "byod.delete_confirm_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the imported game data in ~/Library/Application Support/NewPal/PalGame. Your save files in ~/Library/Application Support/com.steveshi/NewPal/Save will be preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将清理 ~/Library/Application Support/NewPal/PalGame 中的游戏数据包，~/Library/Application Support/com.steveshi/NewPal/Save 中的玩家存档将会完整保留。"
          }
        }
      }
    },
    "byod.delete_confirm_action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Game Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认删除"
          }
        }
      }
    },
    "byod.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
