    "whatsnew.feature2.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added an Open Application Support shortcut and a confirmation-guarded Delete Game Data action, while isolating saves exclusively in ~/Library/Application Support/NewPal/Save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增「打开 Application Support」快捷按钮与带二次确认的「删除游戏数据」功能，并将玩家存档独立写入 ~/Library/Application Support/NewPal/Save，清理数据不会影响存档。"
          }
        }
      }
    },
