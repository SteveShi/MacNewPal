    "settings.hd_filter_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HD Remastered or active Metal GPU shaders override legacy nearest/bilinear scaling while keeping CoreText UI crisp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用高清重制或 Metal GPU 滤镜时会自动接管像素缩放，同时保持 CoreText 界面字体视网膜级锐利。"
          }
        }
      }
    },
