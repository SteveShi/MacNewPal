        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未导入"
          }
        }
      }
    },
    "byod.importing_preparing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing game data import…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备导入游戏数据包…"
          }
