    "whatsnew.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's New in NewPal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NewPal 更新说明"
          }
        }
      }
    },
    "whatsnew.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 1.1.0 — Full 8-Chapter Parity & Side-Quest Audit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1.1.0 版 — 全八章原版逻辑对齐与 31 条支线全面核验"
          }
        }
      }
    },
    "whatsnew.feature1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact Palgame.exe Combat, Alchemy & World Parity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全面对齐 Palgame.exe 战斗、炼蛊与大世界机制"
          }
        }
      }
    },
    "whatsnew.feature1.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaced all approximated formulas with reverse-engineered Palgame.exe logic: gmap.dat + all_map2.act battlegrounds, P0–P3 damage/status/steal/drop/turn-order rules, 99-level cap, alchemy pot, and dungeon exits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按原版 Palgame.exe 逆向逻辑重写战斗公式、专属战斗场景（gmap.dat + all_map2.act）、异常状态/双槽掉落/出手顺序、99 级上限、炼蛊皿与 32 组迷宫出口。"
          }
        }
      }
    },
    "whatsnew.feature2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "31 Side Quests, Hidden Endings & Full 8-Chapter Verified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全八章通关实测、双隐藏结局与 31 条支线验证通过"
          }
        }
      }
    },
    "whatsnew.feature2.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audited and regression-tested all 8 chapters, both hidden endings (Zhao Ling'er 1195 & Lin Yueru 1199), and 31 early/mid/late side quests including Peach Village, Gu-Eating Bird AI & Map 460, and Five-God Statues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成全八章主线通关实测、赵灵儿（1195）与林月如（1199）双隐藏结局以及桃源村、捕捉食蛊鸟、女娲遗迹五神像等 31 条早中后期支线修复与回归校验。"
          }
        }
      }
    },
    "whatsnew.feature3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal Shaders, SDL3 Gamepad & Built-in MCP Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal 滤镜、SDL3 手柄与内置 MCP 自动化接口"
          }
        }
      }
    },
    "whatsnew.feature3.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware Metal xBRZ / CRT-Royale shaders with Retina-crisp CoreText UI, smooth BGM crossfades, hotplug SDL3 Gamepad controls, V6 extended saves, and built-in stdio MCP server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件 Metal xBRZ / CRT-Royale 滤镜配视网膜级字体、平滑 BGM 淡入淡出、SDL3 手柄热插拔、V6 扩展存档与内置 stdio MCP 服务端。"
          }
        }
      }
    },
    "whatsnew.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
