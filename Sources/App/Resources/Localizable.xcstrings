{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NewPal for macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新仙剑奇侠传 macOS 版启动器"
          }
        }
      }
    },
