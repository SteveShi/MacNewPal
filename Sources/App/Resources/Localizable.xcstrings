    },
    "byod.importing_progress_fmt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying required game data: %@ / %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在复制必需游戏数据：%@ / %@"
          }
        }
      }
    },
    "byod.import_validation_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import aborted: only %lld of %lld required archive checks passed. Please select a complete original PalGame folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校验未通过（仅通过 %lld / %lld 项），未执行导入。请选择包含完整原版数据的游戏文件夹。"
          }
        }
      }
    },
    "byod.standard_path_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard data folder name & path: ~/Library/Application Support/NewPal/PalGame"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准数据文件夹命名与路径：~/Library/Application Support/NewPal/PalGame"
          }
        }
      }
    },
    "byod.revalidate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-Validate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新校验"
          }
        }
      }
    },
