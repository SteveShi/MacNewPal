    "byod.card_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original Game Data Directory (BYOD)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原版游戏数据目录（自备正版资产）"
          }
        }
      }
    },
    "byod.legal_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No copyrighted sprites, audio, scripts, or maps are bundled. Select your own legal copy of PalGame to verify and play directly from archive containers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不含任何受版权保护的美术、音频、脚本或地图资源。请选择您合法拥有的原版《新仙剑奇侠传》游戏目录，通过内存 VFS 直接校验并挂载运行。"
          }
        }
      }
    },
    "byod.no_folder_selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No game directory selected yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未选择原版游戏目录。"
          }
        }
