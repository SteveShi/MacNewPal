    "whatsnew.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's New in NewPal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NewPal 更新说明"
          }
        }
      }
    },
    "whatsnew.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 1.2.1 — Managed BYOD Data Import & Cleanup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2.1 版 — 托管式数据包导入与标准目录管理"
          }
        }
      }
    },
    "whatsnew.feature1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Managed BYOD Import into Application Support"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托管式数据包导入至 macOS 标准目录"
          }
        }
      }
    },
    "whatsnew.feature1.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validates all 23 core archives and selectively copies only required game files into ~/Library/Application Support/NewPal/PalGame with live progress. Once imported, the original folder can be freely deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动校验全部 23 项核心档案并仅选择性复制所需游戏文件至 ~/Library/Application Support/NewPal/PalGame，实时显示进度；导入完成后原游戏文件夹可自由删除。"
          }
        }
      }
    },
    "whatsnew.feature2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard Folder Shortcut & Safe Data Cleanup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
